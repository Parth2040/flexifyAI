# ─────────────────────────────────────────────────────────────
# FlexifyAI environment variables
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored and is where your real secrets live.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string (stores users + waitlist)
# e.g. mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/flexify-ai
MONGODB_URI=

# Google OAuth credentials (Google Cloud Console → APIs & Services → Credentials)
# Create an "OAuth 2.0 Client ID" of type "Web application".
# Authorized redirect URI must be: http://localhost:3000/api/auth/google/callback
# (and your production URL's /api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret used to sign the session cookie.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# OpenAI API key (used to generate images from the uploaded photo + prompt)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Public base URL of the app. Used to build the OAuth redirect URI.
# Leave as-is for local dev; set to your real domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Polar Payments (https://polar.sh) — one-time purchases → credits
# Organization Access Token (Polar dashboard → Settings → Developers)
POLAR_ACCESS_TOKEN=
# Webhook signing secret (Polar dashboard → Settings → Webhooks)
POLAR_WEBHOOK_SECRET=
# "sandbox" while developing, "production" when live
POLAR_ENVIRONMENT=sandbox
# Product IDs for each plan — create them as ONE-TIME products in the Polar dashboard
POLAR_PRODUCT_STARTER=
POLAR_PRODUCT_PRO=
POLAR_PRODUCT_ELITE=

# Telegram payment notifications (optional) — a message is sent on each payment
# Bot token from @BotFather (the part after /bot in the sendMessage URL)
TELEGRAM_BOT_TOKEN=
# Chat/channel/user id to send notifications to
TELEGRAM_CHAT_ID=

# Analytics — these are PUBLIC (sent to the browser), hence NEXT_PUBLIC_*
# Google Analytics 4 Measurement ID (Admin → Data Streams), e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# PostHog project API key (Project Settings), e.g. phc_xxx
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog host: https://us.i.posthog.com or https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
